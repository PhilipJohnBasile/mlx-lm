+            [mx.float16, mx.bfloat16, mx.float32]
+        ):
+            with self.subTest(shape=leading, k=k, d=d, dtype=str(dtype)):
+                x = mx.random.normal((*leading, d)).astype(dtype)
+                idx = mx.random.randint(0, 17, (*leading, k)).astype(mx.uint32)
+                self.check(x, idx)
